---
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';

const sourceDirectory = join(process.cwd(), 'site-html-archive/pages');
const sourceFiles = (await readdir(sourceDirectory)).filter((file) => file.endsWith('.html'));

export async function getStaticPaths() {
  const directory = join(process.cwd(), 'site-html-archive/pages');
  const files = (await readdir(directory)).filter((file) => file.endsWith('.html'));
  return files.map((file) => ({ params: { slug: file === 'index.html' ? undefined : file.slice(0, -5) } }));
}

const slug = Array.isArray(Astro.params.slug) ? Astro.params.slug.join('/') : Astro.params.slug;
const sourceName = slug ? `${slug}.html` : 'index.html';
if (!sourceFiles.includes(sourceName)) {
  throw new Error(`No archived source for ${sourceName}`);
}
const original = await readFile(join(sourceDirectory, sourceName), 'utf8');
const home = JSON.parse(await readFile(join(process.cwd(), 'content/home.json'), 'utf8'));
const capture = (expression: RegExp, fallback = '') => original.match(expression)?.[1] ?? fallback;
const originalTitle = capture(/<title>([\s\S]*?)<\/title>/i, 'Penn KDSAP');
const pageLabel = originalTitle.replace(/\s*\|\s*Penn KDSAP/i, '').trim();
const title = pageLabel === 'Home'
  ? 'Penn KDSAP | Kidney Disease Screening & Awareness at Penn'
  : `${pageLabel} | Penn KDSAP`;
const description = pageLabel === 'Home'
  ? 'Penn KDSAP is a student-led organization advancing kidney disease screening, health education, and community awareness in Philadelphia.'
  : `Learn about ${pageLabel} at Penn KDSAP, a student-led kidney disease screening and awareness organization at the University of Pennsylvania.`;
const image = capture(/<meta property="og:image" content="([^"]+)"/i);
const styles = [...original.matchAll(/<style[^>]*>[\s\S]*?<\/style>/gi)].map((match) => match[0]).join('\n');
const header = capture(/(<header\b[\s\S]*?<\/header>)/i);
const main = capture(/(<main\b[\s\S]*?<\/main>)/i);
const footer = capture(/(<footer\b[\s\S]*?<\/footer>)/i);
const body = [header, main, footer].filter(Boolean).join('\n');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localizedBody = body
  .replaceAll('https://www.pennkdsap.org/', `${base}/`)
  .replaceAll('https://www.pennkdsap.org', base);
const path = slug ? `/${slug}/` : '/';
const canonical = new URL(`${import.meta.env.BASE_URL}${slug ? `${slug}/` : ''}`, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.png`} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Penn KDSAP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <meta name="robots" content="index, follow" />
    <Fragment set:html={styles} />
    <style is:global>body { margin: 0; }</style>
  </head>
  <body data-page={path}>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="Penn KDSAP home"><img src={`${base}/images/penn-kdsap-logo.png`} alt="Penn KDSAP — Kidney Disease Screening and Awareness Program" /></a>
      <nav aria-label="Main navigation">
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/about/`}>About</a>
        <a href={`${base}/what-we-do/`}>What We Do</a>
        <a href={`${base}/about-1/`}>Kidney Health on a Plate</a>
        <a href={`${base}/meet-the-team/`}>Meet the Team</a>
        <a href={`${base}/gallery/`}>Gallery</a>
        <a href={`${base}/contact-us/`}>Contact Us</a>
      </nav>
    </header>
    {slug === undefined ? (
      <main class="home-page">
        <section class="carousel" aria-label="Penn KDSAP highlights">
          {home.slides.map((slide: { eyebrow: string; title: string; image: string }, index: number) => (
            <article class:list={['carousel-slide', { 'is-active': index === 0 }]} data-slide={index} aria-hidden={index === 0 ? 'false' : 'true'}>
              <img src={`${base}${slide.image}`} alt="" />
              <div class="slide-overlay"></div>
              <div class="slide-copy"><p>{slide.eyebrow}</p><h1>{slide.title}</h1></div>
            </article>
          ))}
          <button class="carousel-arrow previous" type="button" aria-label="Previous slide">‹</button>
          <button class="carousel-arrow next" type="button" aria-label="Next slide">›</button>
          <div class="carousel-dots" aria-label="Choose slide">{home.slides.map((_: unknown, index: number) => <button class:list={{ 'is-active': index === 0 }} type="button" data-dot={index} aria-label={`Slide ${index + 1}`}></button>)}</div>
        </section>
        <section class="newsletter-section">
          <div><h2>{home.newsletterTitle}</h2><p>{home.newsletterText}</p><a class="newsletter-button" href={home.newsletterUrl} target="_blank" rel="noreferrer">Newsletter</a></div>
        </section>
        <section class="recap-section"><div><h2>{home.recapTitle}</h2><p>{home.recapText}</p><a href={`${base}/about-3/`}>Learn more</a></div></section>
        <section class="intro-section"><p>{home.aboutText}</p><p>{home.contactText} <a href={`${base}/contact-us/`}>Please contact us.</a></p></section>
      </main>
    ) : (
      <main class="archived-page"><Fragment set:html={localizedBody} /></main>
    )}
    <footer class="site-footer">© 2025 Penn KDSAP · <a href="mailto:pennkdsap@gmail.com">pennkdsap@gmail.com</a></footer>
  </body>
</html>

<script is:inline>
  const carousel = document.querySelector('.carousel');
  if (carousel) {
    const slides = [...carousel.querySelectorAll('.carousel-slide')];
    const dots = [...carousel.querySelectorAll('[data-dot]')];
    let active = 0;
    const changeSlide = (index) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => { slide.classList.toggle('is-active', i === active); slide.setAttribute('aria-hidden', i === active ? 'false' : 'true'); });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
    };
    carousel.querySelector('.previous').addEventListener('click', () => changeSlide(active - 1));
    carousel.querySelector('.next').addEventListener('click', () => changeSlide(active + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => changeSlide(i)));
    setInterval(() => changeSlide(active + 1), 7000);
  }
</script>

<style is:global>
  :root { --navy: #1b355f; --blue: #2d6eaa; --ink: #111; --peach: #ffd8ad; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); font-family: Arial, sans-serif; }
  .site-header { align-items: center; background: #fff; display: flex; gap: 2.5rem; justify-content: space-between; min-height: 128px; padding: 17px max(4vw, calc((100% - 1490px) / 2)); position: relative; z-index: 2; }
  .brand { display: block; width: min(440px, 33vw); }
  .brand img { display: block; height: auto; width: 100%; }
  .site-header nav { align-items: center; display: flex; flex-wrap: wrap; gap: clamp(1rem, 1.5vw, 2.2rem); }
  .site-header nav a { color: var(--blue); font-family: Arial, sans-serif; font-size: clamp(15px, 1.2vw, 22px); text-decoration: none; white-space: nowrap; }
  .site-header nav a:hover { color: var(--navy); }
  .carousel { height: min(66vw, 855px); min-height: 520px; overflow: hidden; position: relative; }
  .carousel-slide { inset: 0; opacity: 0; position: absolute; transition: opacity .7s ease; }
  .carousel-slide.is-active { opacity: 1; }
  .carousel-slide > img, .slide-overlay { height: 100%; inset: 0; position: absolute; width: 100%; }
  .carousel-slide > img { object-fit: cover; object-position: center; }
  .slide-overlay { background: rgba(0,0,0,.27); }
  .slide-copy { color: white; left: 50%; position: absolute; text-align: center; text-shadow: 0 3px 5px rgba(0,0,0,.38); top: 12%; transform: translateX(-50%); width: min(95%, 1200px); }
  .slide-copy p { font-family: Georgia, serif; font-size: clamp(22px, 2vw, 34px); font-style: italic; margin: 0 0 1.8rem; }
  .slide-copy h1 { font-family: Arial, sans-serif; font-size: clamp(35px, 4.6vw, 80px); font-weight: 300; letter-spacing: .08em; line-height: 1.06; margin: 0; }
  .carousel-arrow { background: transparent; border: 0; color: #eee; cursor: pointer; font-family: Georgia, serif; font-size: clamp(70px, 6vw, 120px); font-weight: 200; line-height: 1; padding: 0; position: absolute; top: 47%; transform: translateY(-50%); z-index: 1; }
  .carousel-arrow.previous { left: clamp(2rem, 6.5vw, 8rem); } .carousel-arrow.next { right: clamp(2rem, 6.5vw, 8rem); }
  .carousel-dots { bottom: 5.5%; display: flex; gap: 12px; left: 50%; position: absolute; transform: translateX(-50%); }
  .carousel-dots button { background: #eee; border: 0; border-radius: 50%; cursor: pointer; height: 9px; opacity: .75; padding: 0; width: 9px; } .carousel-dots button.is-active { opacity: 1; }
  .newsletter-section { align-items: center; background: var(--peach); display: flex; justify-content: center; min-height: 510px; padding: 5rem 1.5rem; text-align: center; }
  .newsletter-section > div { max-width: 940px; } .newsletter-section h2 { color: #111; font-size: clamp(38px, 4.4vw, 78px); font-weight: 400; margin: 0 0 1.5rem; } .newsletter-section p { font-size: 22px; line-height: 1.55; }
  .newsletter-button, .recap-section a { border: 1px solid currentColor; color: var(--navy); display: inline-block; font-size: 18px; margin-top: 1rem; padding: .75rem 2rem; text-decoration: none; }
  .recap-section { padding: 7rem max(1.5rem, calc((100% - 950px) / 2)); text-align: center; } .recap-section h2 { font-size: 50px; } .recap-section p, .intro-section { font-size: 20px; line-height: 1.7; }
  .intro-section { margin: 0 auto; max-width: 1050px; padding: 2rem 2rem 6rem; text-align: center; } .intro-section a { color: var(--blue); }
  .site-footer { background: #fff; color: #555; font-size: 15px; padding: 2rem; text-align: center; } .site-footer a { color: var(--blue); }
  .archived-page > header, .archived-page > footer { display: none; }
  @media (max-width: 900px) { .site-header { align-items: flex-start; flex-direction: column; gap: .75rem; min-height: 0; padding: 1.25rem; } .brand { width: 330px; } .carousel { height: 76vw; min-height: 450px; } .slide-copy { top: 14%; } .newsletter-section { min-height: 430px; } }
</style>
