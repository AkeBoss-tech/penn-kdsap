---
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';

const sourceDirectory = join(process.cwd(), 'site-html-archive/pages');
const sourceFiles = (await readdir(sourceDirectory)).filter((file) => file.endsWith('.html'));

export async function getStaticPaths() {
  const directory = join(process.cwd(), 'site-html-archive/pages');
  const files = (await readdir(directory)).filter((file) => file.endsWith('.html'));
  return files.map((file) => ({ params: { slug: file === 'index.html' ? undefined : file.slice(0, -5) } }));
}

const slug = Array.isArray(Astro.params.slug) ? Astro.params.slug.join('/') : Astro.params.slug;
const sourceName = slug ? `${slug}.html` : 'index.html';
if (!sourceFiles.includes(sourceName)) {
  throw new Error(`No archived source for ${sourceName}`);
}
const original = await readFile(join(sourceDirectory, sourceName), 'utf8');
const home = JSON.parse(await readFile(join(process.cwd(), 'content/home.json'), 'utf8'));
const capture = (expression: RegExp, fallback = '') => original.match(expression)?.[1] ?? fallback;
const originalTitle = capture(/<title>([\s\S]*?)<\/title>/i, 'Penn KDSAP');
const pageLabel = originalTitle.replace(/\s*\|\s*Penn KDSAP/i, '').trim();
const title = pageLabel === 'Home'
  ? 'Penn KDSAP | Kidney Disease Screening & Awareness at Penn'
  : `${pageLabel} | Penn KDSAP`;
const description = pageLabel === 'Home'
  ? 'Penn KDSAP is a student-led organization advancing kidney disease screening, health education, and community awareness in Philadelphia.'
  : `Learn about ${pageLabel} at Penn KDSAP, a student-led kidney disease screening and awareness organization at the University of Pennsylvania.`;
const image = capture(/<meta property="og:image" content="([^"]+)"/i);
const styles = [...original.matchAll(/<style[^>]*>[\s\S]*?<\/style>/gi)].map((match) => match[0]).join('\n');
const header = capture(/(<header\b[\s\S]*?<\/header>)/i);
const main = capture(/(<main\b[\s\S]*?<\/main>)/i);
const footer = capture(/(<footer\b[\s\S]*?<\/footer>)/i);
const body = [header, main, footer].filter(Boolean).join('\n');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localizedBody = body
  .replaceAll('https://www.pennkdsap.org/', `${base}/`)
  .replaceAll('https://www.pennkdsap.org', base);
const path = slug ? `/${slug}/` : '/';
const canonical = new URL(`${import.meta.env.BASE_URL}${slug ? `${slug}/` : ''}`, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.png`} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Penn KDSAP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <meta name="robots" content="index, follow" />
    <Fragment set:html={styles} />
    <style is:global>body { margin: 0; }</style>
  </head>
  <body data-page={path}>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="Penn KDSAP home">Penn KDSAP</a>
      <nav aria-label="Main navigation">
        <a href={`${base}/about/`}>About</a>
        <a href={`${base}/what-we-do/`}>What We Do</a>
        <a href={`${base}/kidney-screenings/`}>Screenings</a>
        <a href={`${base}/meet-the-team/`}>Team</a>
        <a href={`${base}/gallery/`}>Gallery</a>
        <a href={`${base}/contact-us/`}>Contact</a>
      </nav>
    </header>
    {slug === undefined ? (
      <main class="home-page">
        <section class="hero" style={`background-image: linear-gradient(90deg, rgba(7, 40, 72, .86), rgba(7, 40, 72, .35)), url('${base}${home.heroImage}')`}>
          <div>
            <p class="eyebrow">University of Pennsylvania</p>
            <h1>{home.heroTitle}</h1>
            <p>{home.heroText}</p>
            <a class="button" href={`${base}/contact-us/`}>Schedule a screening</a>
          </div>
        </section>
        <section class="content-block split">
          <div><p class="eyebrow">Stay connected</p><h2>{home.newsletterTitle}</h2><p>{home.newsletterText}</p><a class="text-link" href={home.newsletterUrl} target="_blank" rel="noreferrer">Read the newsletter →</a></div>
          <div><p class="eyebrow">Our impact</p><h2>{home.recapTitle}</h2><p>{home.recapText}</p><a class="text-link" href={`${base}/about-3/`}>Learn more →</a></div>
        </section>
        <section class="content-block about"><p class="eyebrow">Penn KDSAP</p><h2>Kidney health belongs in every community.</h2><p>{home.aboutText}</p><p>{home.contactText} <a class="text-link" href={`${base}/contact-us/`}>Contact us.</a></p></section>
      </main>
    ) : (
      <main class="archived-page"><Fragment set:html={localizedBody} /></main>
    )}
    <footer class="site-footer">© 2025 Penn KDSAP · <a href="mailto:pennkdsap@gmail.com">pennkdsap@gmail.com</a></footer>
  </body>
</html>

<style is:global>
  :root { --navy: #072848; --blue: #1c679c; --ink: #132536; --cream: #f6f8fa; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); font-family: Arial, sans-serif; }
  .site-header { align-items: center; background: #fff; display: flex; gap: 2rem; justify-content: space-between; padding: 1rem clamp(1.25rem, 5vw, 5rem); position: relative; z-index: 2; }
  .brand { color: var(--navy); font-size: 1.35rem; font-weight: 800; letter-spacing: .03em; text-decoration: none; }
  .site-header nav { display: flex; flex-wrap: wrap; gap: 1.15rem; }
  .site-header nav a, .site-footer a { color: var(--navy); text-decoration: none; }
  .site-header nav a:hover, .text-link:hover { text-decoration: underline; }
  .hero { align-items: center; background-position: center; background-size: cover; color: #fff; display: flex; min-height: min(70vh, 46rem); padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 11vw, 11rem); }
  .hero > div { max-width: 46rem; }
  .eyebrow { color: var(--blue); font-size: .78rem; font-weight: 700; letter-spacing: .12em; margin: 0 0 .8rem; text-transform: uppercase; }
  .hero .eyebrow { color: #c4e3f5; }
  h1 { font-size: clamp(2.6rem, 6vw, 5.5rem); line-height: 1.02; margin: 0 0 1.25rem; max-width: 12ch; }
  h2 { color: var(--navy); font-size: clamp(1.7rem, 3vw, 2.7rem); line-height: 1.15; margin: 0 0 1rem; }
  .hero p:not(.eyebrow), .content-block p { font-size: 1.1rem; line-height: 1.7; }
  .button { background: #fff; border-radius: .25rem; color: var(--navy); display: inline-block; font-weight: 700; margin-top: 1rem; padding: .9rem 1.2rem; text-decoration: none; }
  .content-block { margin: 0 auto; max-width: 75rem; padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 5vw, 4rem); }
  .split { display: grid; gap: 4rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .split > div + div { border-left: 1px solid #d9e0e6; padding-left: 4rem; }
  .about { background: var(--cream); max-width: none; padding-left: max(1.5rem, calc((100% - 67rem) / 2)); padding-right: max(1.5rem, calc((100% - 67rem) / 2)); }
  .about > * { max-width: 60rem; }
  .text-link { color: var(--blue); font-weight: 700; }
  .site-footer { background: var(--navy); color: #fff; padding: 2rem clamp(1.5rem, 5vw, 5rem); }
  .site-footer a { color: #d7efff; }
  .archived-page > header, .archived-page > footer { display: none; }
  @media (max-width: 700px) { .site-header { align-items: flex-start; flex-direction: column; gap: .75rem; } .site-header nav { gap: .8rem; } .split { grid-template-columns: 1fr; gap: 2.5rem; } .split > div + div { border-left: 0; border-top: 1px solid #d9e0e6; padding-left: 0; padding-top: 2.5rem; } }
</style>
